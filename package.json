{
  "name": "iplc-form-builder",
  "version": "2.0.0",
  "description": "IPLC Form Builder - Modern ES6 modular architecture with SurveyJS",
  "type": "module",
  "private": true,
  "author": "IPLC Development Team",
  "license": "UNLICENSED",
  "homepage": "https://github.com/peterdarley/ArticEval",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterdarley/ArticEval.git"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "ANALYZE=true vite build",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules package-lock.json",
    "lint": "eslint src --ext .js,.jsx --fix",
    "lint:check": "eslint src --ext .js,.jsx",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,scss,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:preview": "npm run build && wrangler pages deploy dist --branch preview"
  },
  "dependencies": {
    "@cloudflare/ai": "^1.2.2",
    "@langchain/cloudflare": "^0.1.0",
    "@langchain/community": "^0.3.48",
    "@langchain/core": "^0.3.62",
    "knockout": "^3.5.1",
    "qrcode": "^1.5.3",
    "survey-core": "^1.9.139",
    "survey-creator-core": "^1.9.139",
    "survey-creator-knockout": "^1.9.139"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@cloudflare/workers-types": "^4.20231218.0",
    "@playwright/test": "^1.40.1",
    "@storybook/addon-docs": "^9.0.16",
    "@storybook/addon-links": "^9.0.16",
    "@storybook/html-vite": "^9.0.16",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.11",
    "@vitejs/plugin-legacy": "^5.2.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-storybook": "^9.0.16",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.69.7",
    "storybook": "^9.0.16",
    "terser": "^5.26.0",
    "vite": "^5.0.10",
    "wrangler": "^3.22.1"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "keywords": [
    "form-builder",
    "surveyjs",
    "cloudflare-pages",
    "vite",
    "es6-modules",
    "drag-drop",
    "ai-assistant"
  ]
}
