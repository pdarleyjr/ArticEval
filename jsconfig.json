{
  "compilerOptions": {
    "checkJs": false,
    "allowJs": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "functions"
  ],
  "include": [
    "public/**/*"
  ]
}