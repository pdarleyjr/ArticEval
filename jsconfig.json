{
  "compilerOptions": {
    "target": "es2015",
    "module": "commonjs",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "public/assets/js/form-builder.js"
  ],
  "include": [
    "public/**/*",
    "functions/**/*"
  ]
}